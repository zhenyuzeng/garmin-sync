# Garmin 国内版账号
GARMIN_CN_EMAIL=your_cn_account@example.com
GARMIN_CN_PASSWORD=your_password

# Garmin 国际版账号
GARMIN_INTL_EMAIL=your_intl_account@example.com
GARMIN_INTL_PASSWORD=your_password

# 同步配置
# 回溯天数：每次运行时，检查最近 N 天的活动
LOOKBACK_DAYS=7
# 令牌存储目录（默认 ~/.garminconnect/）
# TOKEN_DIR=~/.garminconnect/

# 手机推送（Bark，可选——不配置则只发电脑通知）
# iPhone 装 Bark App 后，把 App 里的设备 key 填入 URL
BARK_API=https://api.day.app/your-device-key
